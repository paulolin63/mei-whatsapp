# Copy to .env and fill in your own values. Never commit a real .env.
# Copie para .env e preencha com os seus valores. Nunca commite um .env real.

# HTTP port for the webhook server / Porta do servidor de webhook
PORT=3000

# WhatsApp Cloud API — get these from Meta Developers (developers.facebook.com)
# Token de acesso e ID do número de telefone da API de nuvem do WhatsApp.
WHATSAPP_VERIFY_TOKEN=troque-este-token-de-verificacao
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Data directory for the JSON store (default: ./data)
DATA_DIR=data

# Gemini API — for real multimodal receipt OCR (optional, falls back to stub)
# Obtenha em https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
